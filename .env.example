# =============================================================================
# checkmAIte Environment Variables (Development Defaults)
# =============================================================================
# This file contains WORKING defaults for local development.
# The dev script will auto-copy this to .env.local if it doesn't exist.
#
# For production, generate new secrets with: openssl rand -base64 32
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Docker)
# -----------------------------------------------------------------------------
# Default connection for Docker Compose PostgreSQL container
# Container is started automatically by `npm run dev`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/checkmaite"

# -----------------------------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------------------------
# Development-only secret - DO NOT use in production!
NEXTAUTH_SECRET="checkmaite-dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# API Keys Encryption
# -----------------------------------------------------------------------------
# Development-only encryption key - DO NOT use in production!
API_KEYS_ENCRYPTION_SECRET="checkmaite-encryption-key-32-chars!"

# -----------------------------------------------------------------------------
# AI Chat (Optional)
# -----------------------------------------------------------------------------
# Groq API key for AI chess commentary
# Get your free key at: https://console.groq.com/keys
# Without this, users must add their own key in Account -> Settings
GROQ_API_KEY=
